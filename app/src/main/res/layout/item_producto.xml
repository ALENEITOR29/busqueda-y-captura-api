<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" app:cardCornerRadius="14dp" app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Galaxy background image for each character card -->
        <ImageView
            android:id="@+id/imgFondoGalaxia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/galaxy_image_desc" />

        <!-- Dark semi-transparent overlay to ensure text readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B80B0D19" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <ImageView android:id="@+id/imgProducto"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/product_image_desc" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView android:id="@+id/tvNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/default_product_name"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView android:id="@+id/tvCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/default_category"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:paddingTop="2dp" />

                <TextView android:id="@+id/tvPrecio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/default_price"
                    android:textColor="#FEB2B2"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingTop="4dp" />

                <TextView android:id="@+id/tvRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/default_rating"
                    android:textColor="#F6E05E"
                    android:textSize="13sp"
                    android:paddingTop="2dp" />

                <Button android:id="@+id/btnRecompensa"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/bounty_button"
                    android:textSize="11sp"
                    android:backgroundTint="#8B0000"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
